## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/

# Migrate files
Migrations/

# User-specific files
*.rsuser
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE / editor settings
.vs/
.idea/
.vscode/

# ASP.NET Core / local config
appsettings.Local.json
appsettings.*.local.json
secrets.json

# Entity Framework / local database files
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS-generated files
Thumbs.db
.DS_Store

@model IEnumerable<RecipeManagement.Models.Recipe>

@{
  ViewData["Title"] = "All Recipes";
}

<div class="animate-fade-in">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
    <h1 class="mb-3 mb-md-0">
      <i class="fas fa-utensils me-2" style="color: var(--primary-color);"></i>
      Our Recipes
    </h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <a asp-action="Create" class="btn btn-primary-custom btn-custom">
        <i class="fas fa-plus-circle me-2"></i>Create New Recipe
      </a>
    }
  </div>

  @if (!Model.Any())
  {
    <div class="empty-state">
      <div class="empty-state-icon">🍽️</div>
      <h4>No Recipes Yet!</h4>
      <p>Be the first to share a delicious recipe with our community.</p>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a asp-action="Create" class="btn btn-primary-custom btn-custom">
          <i class="fas fa-plus-circle me-2"></i>Create Your First Recipe
        </a>
      }
    </div>
  }
  else
  {
    <div class="recipes-grid">
      @foreach (var item in Model)
      {
        <div class="recipe-card">
          <div class="card-img-container">
            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
              <img src="@item.ImageUrl" class="recipe-image" alt="@item.Title">
            }
            else
            {
              <div class="no-image">
                <i class="fas fa-image fa-3x"></i>
              </div>
            }
          </div>
          <div class="card-content">
            <h5 class="recipe-title">@item.Title</h5>
            <p class="recipe-description">
              @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
            </p>
            <div class="badge-container">
              <span class="custom-badge badge-difficulty">
                <i class="fas fa-chart-line me-1"></i>@item.Difficulty
              </span>
              <span class="custom-badge badge-time">
                <i class="far fa-clock me-1"></i>@(item.PrepTimeMinutes + item.CookTimeMinutes) min
              </span>
              <span class="custom-badge badge-servings">
                <i class="fas fa-users me-1"></i>@item.Servings
              </span>
            </div>
            <div class="recipe-meta">
              <i class="fas fa-user-circle me-1"></i>
              @(!string.IsNullOrEmpty(item.User?.FirstName) ? $"{item.User.FirstName} {item.User.LastName}" :
(item.User?.UserName ?? "Unknown"))
              <br />
              <i class="far fa-calendar-alt me-1"></i>
              @item.CreatedAt.ToString("MMM dd, yyyy")
            </div>
          </div>
          <div class="card-footer bg-transparent">
            <div class="button-group">
              <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                <i class="fas fa-eye me-1"></i>View
              </a>
              @if (User.Identity?.IsAuthenticated == true &&
                (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == item.UserId ||
                User.IsInRole("Admin")))
              {
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">
                  <i class="fas fa-edit me-1"></i>Edit
                </a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                  <i class="fas fa-trash me-1"></i>Delete
                </a>
              }
            </div>
          </div>
        </div>
      }
    </div>
  }
</div>
@model RecipeManagement.Models.Recipe

@{
  ViewData["Title"] = "Delete Recipe";
}

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow">
        <div class="card-header bg-danger text-white">
          <h3 class="mb-0">Delete Recipe</h3>
        </div>
        <div class="card-body">
          <div class="alert alert-warning">
            <h4 class="alert-heading">Are you sure you want to delete this recipe?</h4>
            <p>This action cannot be undone.</p>
          </div>

          <div class="mb-4">
            <h4>@Model.Title</h4>
            <p class="text-muted">@Model.Description</p>

            <div class="mb-2">
              <span class="badge bg-info">@Model.Difficulty</span>
              <span class="badge bg-secondary">⏱️ @(Model.PrepTimeMinutes + Model.CookTimeMinutes) min</span>
              <span class="badge bg-success">👥 @Model.Servings</span>
            </div>

            <dl class="row">
              <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CreatedAt)
              </dt>
              <dd class="col-sm-9">
                @Model.CreatedAt.ToString("MMMM dd, yyyy")
              </dd>

              <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Ingredients)
              </dt>
              <dd class="col-sm-9">
                <pre
                style="white-space: pre-wrap; font-family: inherit; max-height: 100px; overflow-y: auto;">@Model.Ingredients</pre>
              </dd>
            </dl>
          </div>

          <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Confirm Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
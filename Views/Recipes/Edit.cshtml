@using System.Linq
@model RecipeManagement.Models.Recipe

@{
  ViewData["Title"] = "Edit Recipe";
}

<div class="form-container animate-fade-in">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="fas fa-edit me-2"></i>Edit Recipe</h3>
      <p class="mb-0 mt-2">Update your delicious recipe!</p>
    </div>
    <div class="form-body">
      <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="form-group mb-3">
          <label asp-for="Title" class="form-label fw-bold"></label>
          <input asp-for="Title" class="form-control" placeholder="Enter recipe title" />
          <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- CATEGORIES AS CHECKBOXES - WORKING VERSION -->
        <div class="form-group mb-3">
          <label class="form-label fw-bold">
            <i class="fas fa-tags me-1"></i>Categories (Select all that apply)
          </label>
          <div class="categories-checkbox-group">
            @if (ViewBag.CategoriesWithDetails != null)
            {
              // Convert ViewBag.SelectedCategories to a List<int> to use Contains
              var selectedList = new List<int>();
              if (ViewBag.SelectedCategories != null)
              {
                selectedList = ((int[])ViewBag.SelectedCategories).ToList();
              }

              foreach (var category in ViewBag.CategoriesWithDetails)
              {
                bool isSelected = selectedList.Contains(category.Id);
                <label class="category-checkbox">
                  <input type="checkbox" name="selectedCategories" value="@category.Id" @(isSelected ? "checked" : "") />
                  <span class="checkbox-label" style="background-color: @category.Color; border-color: @category.Color;">
                    <i class="fas @category.Icon me-1"></i>
                    @category.Name
                  </span>
                </label>
              }
            }
          </div>
          <small class="form-text text-muted">
            <i class="fas fa-info-circle me-1"></i>
            You can select multiple categories for your recipe
          </small>
        </div>

        <div class="form-group mb-3">
          <label asp-for="Description" class="form-label fw-bold"></label>
          <textarea asp-for="Description" class="form-control" rows="3"
                    placeholder="Brief description of your recipe"></textarea>
          <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
          <label asp-for="Ingredients" class="form-label fw-bold"></label>
          <textarea asp-for="Ingredients" class="form-control" rows="6"
                    placeholder="One ingredient per line"></textarea>
          <small class="form-text text-muted">Enter each ingredient on a new line</small>
          <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
          <label asp-for="Instructions" class="form-label fw-bold"></label>
          <textarea asp-for="Instructions" class="form-control" rows="6"
                    placeholder="Step by step instructions"></textarea>
          <small class="form-text text-muted">Enter each step on a new line</small>
          <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <div class="row">
          <div class="col-md-4">
            <div class="form-group mb-3">
              <label asp-for="PrepTimeMinutes" class="form-label fw-bold"></label>
              <div class="input-group">
                <input asp-for="PrepTimeMinutes" class="form-control" type="number" min="0" />
                <span class="input-group-text">minutes</span>
              </div>
              <span asp-validation-for="PrepTimeMinutes" class="text-danger"></span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group mb-3">
              <label asp-for="CookTimeMinutes" class="form-label fw-bold"></label>
              <div class="input-group">
                <input asp-for="CookTimeMinutes" class="form-control" type="number" min="0" />
                <span class="input-group-text">minutes</span>
              </div>
              <span asp-validation-for="CookTimeMinutes" class="text-danger"></span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group mb-3">
              <label asp-for="Servings" class="form-label fw-bold"></label>
              <div class="input-group">
                <input asp-for="Servings" class="form-control" type="number" min="1" />
                <span class="input-group-text">people</span>
              </div>
              <span asp-validation-for="Servings" class="text-danger"></span>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group mb-3">
              <label asp-for="Difficulty" class="form-label fw-bold"></label>
              <select asp-for="Difficulty" class="form-select">
                <option value="Easy">🍽️ Easy</option>
                <option value="Medium">⭐ Medium</option>
                <option value="Hard">🔥 Hard</option>
              </select>
              <span asp-validation-for="Difficulty" class="text-danger"></span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group mb-3">
              <label asp-for="ImageUrl" class="form-label fw-bold"></label>
              <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/delicious-food.jpg" />
              <small class="form-text text-muted">Optional: Add a URL for your recipe image</small>
              <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary-custom btn-custom">
            <i class="fas fa-save me-2"></i>Save Changes
          </button>
          <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-times me-2"></i>Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}
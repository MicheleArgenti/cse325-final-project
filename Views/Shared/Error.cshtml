@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5 text-center">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="fas fa-exclamation-triangle fa-5x text-warning"></i>
                    </div>
                    <h1 class="display-4 mb-3">Oops!</h1>
                    <h2 class="text-muted mb-4">Something went wrong</h2>

                    @if (ViewBag.RequestId != null)
                    {
                        <p class="text-muted">
                            <strong>Request ID:</strong> <code>@ViewBag.RequestId</code>
                        </p>
                    }

                    <p class="mt-4">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-lg">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                    </p>

                    <hr class="my-4" />

                    <p class="text-muted small">
                        If the problem persists, please contact support.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
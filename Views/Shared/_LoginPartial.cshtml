@using Microsoft.AspNetCore.Identity
@using RecipeManagement.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
  <form asp-area="Identity" asp-page="/Account/Logout"
        asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm"
        class="navbar-right">
    <ul class="nav navbar-nav navbar-right">
      <li class="nav-item">
        <a class="nav-link text-dark" href="#">Hello @UserManager.GetUserName(User)!</a>
      </li>
      <li class="nav-item">
        <button type="submit" class="btn btn-link nav-link text-dark">Logout</button>
      </li>
    </ul>
  </form>
}
else
{
  <ul class="nav navbar-nav navbar-right">
    <li class="nav-item">
      <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
  </ul>
}
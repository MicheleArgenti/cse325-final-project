@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Privacy Policy</h3>
                </div>
                <div class="card-body">
                    <h4>Your Privacy Matters</h4>
                    <p>At Recipe Manager, we take your privacy seriously. This policy describes how we handle your
                        information.</p>

                        <h5 class="mt-4">Information We Collect</h5>
                        <ul>
                            <li>Account information (name, email)</li>
                            <li>Recipes you create and share</li>
                            <li>Usage data to improve our service</li>
                        </ul>

                        <h5>How We Use Your Information</h5>
                        <ul>
                            <li>To provide and maintain our service</li>
                            <li>To notify you about changes to our service</li>
                            <li>To allow you to participate in interactive features</li>
                            <li>To provide customer support</li>
                        </ul>

                        <h5>Data Storage</h5>
                        <p>All your data is stored locally on your device. We don't use cloud storage unless you explicitly
                            enable it.</p>

                            <h5>Contact Us</h5>
                            <p>If you have any questions about this Privacy Policy, please contact us at
                                privacy@recipemanager.com</p>

                                <hr />
                                <p class="text-muted">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>